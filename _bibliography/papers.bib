@article{TiiS_FACOLE_HITL,
  author = {Shahriari, Reza and Hashky, Amal and Arya, Shivvrat and Audino, Tyler and Ragan, Eric D. and Gogate, Vibhav and Ruiz, Jaime},
  title = {Comparison of Text-Based Inputs for Human-in-the-Loop Feedback in Vision-Language Models},
  journal = {ACM Transactions on Interactive Intelligent Systems},
  year = {2026},
  academic_year = {2025-2026},
  status = {published},
  type = {journal},
  role = {co_author},
  doi = {10.1145/3816700},
